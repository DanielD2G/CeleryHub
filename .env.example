# Required — Redis URL used as Celery broker
CELERY_BROKER_URL=redis://localhost:6379/0

# Database — SQLite by default
# CELERYHUB_DB_PATH=./data/celeryhub.db

# Optional
# CELERY_RESULT_BACKEND=redis://localhost:6379/0   # Defaults to CELERY_BROKER_URL
# PORT=3000                                        # FastAPI server port
# VITE_PORT=5173                                   # Vite dev server port
# CELERYHUB_TASK_TTL=0                             # 0 = no expiration, seconds otherwise
# CORS_ORIGINS=*                                   # Comma-separated allowed origins
